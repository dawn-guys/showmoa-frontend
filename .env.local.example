# 네이버 지도 JS API v3 클라이언트 ID
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 백엔드 API 주소. 서버에서만 쓰므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# 브라우저는 항상 같은 출처의 프록시(/api/backend/*)만 호출한다.
#
# 비워 두면 배포된 개발 백엔드(https://showmoa-dev.duckdns.org)를 쓴다.
# 로컬 백엔드를 띄워 붙일 때만 아래 줄의 주석을 풀면 된다.
# BACKEND_API_URL=http://localhost:8080

# 리프레시 토큰 쿠키(sm_rt)의 수명(초). 비워 두면 14일.
# 계약에 리프레시 토큰의 실제 수명이 없어 값으로 분리해 둔다.
AUTH_REFRESH_MAX_AGE_SECONDS=1209600
